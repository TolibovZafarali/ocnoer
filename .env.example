# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon key for client-side authenticated requests (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service role key for trusted server-side operations only
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public bucket used for published runtime artifacts (manifest + chapter bundles)
SUPABASE_RUNTIME_BUCKET="runtime"

# Fixed email identity used for password-only admin login
ADMIN_LOGIN_EMAIL="admin@example.com"

# Fixed email identity used for password-only player login
PLAYER_LOGIN_EMAIL="player@example.com"
