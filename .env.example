# Prisma runtime connection string (recommended: Supabase pooler / IPv4)
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-1-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Migration/introspection URL.
# Use session pooler when direct db.<ref>.supabase.co is IPv6-only on your network.
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-1-your-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon key required by the shared Supabase helpers
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service role key used for authoring JSON, runtime JSON, and media writes
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public bucket used for authoring JSON, generated runtime JSON, and media files
SUPABASE_RUNTIME_BUCKET="runtime"

# Optional local fallback directory for admin authoring JSON (dev only)
# Defaults to /private/tmp/ocnoer-chapters when NODE_ENV=development
LOCAL_AUTHORING_FALLBACK_DIR=""

# Single admin password for the `/admin` gate
ADMIN_PASSWORD="change-me"
