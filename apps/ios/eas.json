{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": false,
        "image": "sdk-54"
      },
      "env": {
        "EXPO_PUBLIC_OCNOER_CONTENT_MODE": "offline"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "image": "sdk-54"
      },
      "env": {
        "EXPO_PUBLIC_OCNOER_CONTENT_MODE": "offline"
      }
    },
    "production": {
      "environment": "production",
      "ios": {
        "image": "sdk-54"
      },
      "env": {
        "EXPO_PUBLIC_OCNOER_CONTENT_MODE": "offline"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
