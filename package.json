{
  "name": "ocnoer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "dev:web": "next dev --hostname localhost",
    "dev:mobile-api": "next dev --hostname 0.0.0.0",
    "dev:ios": "corepack pnpm --filter @ocnoer/ios start",
    "dev:ios:client": "corepack pnpm --filter @ocnoer/ios start:dev-client",
    "ios:config": "corepack pnpm --filter @ocnoer/ios expo:config",
    "ios:eas:build:development": "corepack pnpm --dir apps/ios run eas:build:development",
    "ios:eas:build:preview": "corepack pnpm --dir apps/ios run eas:build:preview",
    "ios:eas:build:production": "corepack pnpm --dir apps/ios run eas:build:production",
    "ios:eas:submit:production": "corepack pnpm --dir apps/ios run eas:submit:production",
    "build": "next build",
    "build:web": "next build",
    "start": "next start",
    "start:web": "next start",
    "lint": "next lint",
    "lint:web": "next lint",
    "test": "vitest run",
    "test:web": "vitest run",
    "typecheck": "corepack pnpm typecheck:web && corepack pnpm --filter @ocnoer/story-core typecheck && corepack pnpm --filter @ocnoer/ios typecheck",
    "typecheck:web": "tsc --noEmit",
    "backup:storage": "node scripts/backup-storage.mjs",
    "backup:db": "node scripts/backup-postgres.mjs",
    "backup:all": "node scripts/backup-storage.mjs && node scripts/backup-postgres.mjs",
    "audit:ios-portraits": "node scripts/audit-ios-character-portrait-derivatives.mjs",
    "publish:runtime": "node scripts/publish-ios-character-portrait-derivatives.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"apps/**/*.{ts,tsx,js,json,md}\" \"components/**/*.{ts,tsx}\" \"docs/**/*.md\" \"lib/**/*.ts\" \"packages/**/*.{ts,tsx,json,md}\" \"*.{json,mjs,ts,md,yaml}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"apps/**/*.{ts,tsx,js,json,md}\" \"components/**/*.{ts,tsx}\" \"docs/**/*.md\" \"lib/**/*.ts\" \"packages/**/*.{ts,tsx,json,md}\" \"*.{json,mjs,ts,md,yaml}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ocnoer/story-core": "workspace:*",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.7.0"
}
